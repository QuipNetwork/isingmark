# SPDX-License-Identifier: AGPL-3.0-or-later
#
# WARNING: while this file is active as .cargo/config.toml, every cargo
# command rewrites Cargo.lock to path sources for the three patched crates.
# Before you commit, run:
#
#   git diff --stat Cargo.lock
#
# and expect no output (or restore the lock with `git checkout Cargo.lock`).
# Prefer deleting .cargo/config.toml when you are not co-developing upstream
# so the committed lock keeps the crates.io releases.
#
# Copy this file to .cargo/config.toml (gitignored) to build against a local
# quip-solver-core checkout instead of the crates.io releases. Adjust the
# paths to your checkout location.
[patch.crates-io]
quip-proto = { path = "/path/to/quip-solver-core/crates/quip-proto" }
quip-protocol = { path = "/path/to/quip-solver-core/crates/quip-protocol" }
quip-solver-core = { path = "/path/to/quip-solver-core/crates/quip-solver-core" }
